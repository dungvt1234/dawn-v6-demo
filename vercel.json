{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dawn-v6-demo.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bai-viet",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[-a-z0-9]+)"
        }
      ],
      "destination": "/bai-viet/:slug/",
      "statusCode": 301
    },
    {
      "source": "/bai-viet",
      "missing": [
        {
          "type": "query",
          "key": "slug"
        }
      ],
      "destination": "/tin-tuc",
      "statusCode": 301
    }
  ]
}
